# Configure these privately in your destination host. No real values belong here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_BASE_URL=https://YOUR_ZIBANA_DOMAIN
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_GOOGLE_WEB_CLIENT_SECRET
NODE_ENV=production
SIMULATION_MODE_ENABLED=false
# Optional paid integrations: enable only after owner approval.
# OPENAI_API_KEY=
# PAYSTACK_SECRET_KEY=
# FLW_SECRET_KEY=
# FLW_SECRET_HASH=
